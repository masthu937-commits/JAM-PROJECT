
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampusBeats | Music Community</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<div class="app">
    <aside class="sidebar">
        <h2 class="logo">♫ CampusBeats</h2>
        <p class="menu-title">MAIN MENU</p>
        <a href="#home" class="nav-link active">⌂ Home</a>
        <a href="#songs" class="nav-link">♫ Discover Songs</a>
        <a href="#playlist" class="nav-link">☷ My Playlist</a>
        <a href="#jam" class="nav-link">🎸 Jam Sessions</a>

        <div class="sidebar-bottom">
            <div class="big-note">♫</div>
            <h3>Music brings us together!</h3>
            <p>Discover songs, share music and enjoy your campus vibe.</p>
        </div>
    </aside>

    <main class="main-content" id="home">
        <header class="topbar">
            <div>
                <p class="eyebrow">YOUR CAMPUS, YOUR SOUND</p>
                <h2>Hey, Music Lover! 👋</h2>
            </div>
            <div class="profile">🎧 Campus Member</div>
        </header>

        <section class="hero">
            <div class="hero-content">
                <span class="hero-label">🎵 THE CAMPUS MUSIC HUB</span>
                <h1>Good music.<br>Great friends.<br><span>Better memories.</span></h1>
                <p>Discover Telugu hits, build playlists and connect with music lovers on your campus.</p>
                <a href="#songs" class="primary-btn">Explore Songs →</a>
            </div>
            <div class="hero-art">
                <div class="vinyl">♫</div>
                <span class="note note1">♪</span>
                <span class="note note2">♫</span>
                <div class="equalizer"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
            </div>
        </section>

        <section class="stats">
            <div class="stat-card">
                <span class="stat-icon purple">♫</span>
                <div><p>Available Songs</p><h2 id="songCount">0</h2></div>
            </div>
            <div class="stat-card">
                <span class="stat-icon pink">👥</span>
                <div><p>Jam Participants</p><h2 id="memberCount">0</h2></div>
            </div>
            <div class="stat-card">
                <span class="stat-icon orange">♡</span>
                <div><p>Total Votes</p><h2 id="voteCount">0</h2></div>
            </div>
        </section>

        <section id="songs" class="section">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">FIND YOUR VIBE</p>
                    <h2>Trending Telugu Hits 🔥</h2>
                    <p class="muted">Discover your favorites and add them to your playlist.</p>
                </div>
            </div>

            <div class="search-controls">
                <input type="search" id="searchInput" placeholder="🔍 Search songs or movies...">
                <select id="categoryFilter">
                    <option value="all">All Categories</option>
                    <option value="melody">Melody</option>
                    <option value="romantic">Romantic</option>
                    <option value="energetic">Energetic</option>
                    <option value="mass">Mass</option>
                </select>
            </div>

            <div id="songGrid" class="song-grid"></div>
        </section>

        <section class="lower-grid">
            <div class="panel" id="playlist">
                <div class="panel-heading">
                    <div>
                        <p class="eyebrow">MADE TOGETHER</p>
                        <h2>My Playlist 🎧</h2>
                    </div>
                    <span id="playlistBadge" class="badge">0 songs</span>
                </div>
                <p class="muted">Your selected campus tracks appear here.</p>
                <div id="playlistItems"></div>
                <div id="emptyPlaylist" class="empty-state">
                    <div class="empty-note">♫</div>
                    <h3>Your playlist is waiting!</h3>
                    <p>Add some songs to get started.</p>
                </div>
                <button id="clearPlaylist" class="secondary-btn">Clear Playlist</button>
            </div>

            <div class="panel" id="jam">
                <p class="eyebrow">LET'S MAKE SOME NOISE</p>
                <h2>Campus Jam Session 🎸</h2>
                <div class="jam-banner">
                    <div class="mic">🎤</div>
                    <div>
                        <span class="live-label">● CAMPUS EVENT</span>
                        <h3>Friday Music Meetup</h3>
                        <p>Bring your friends and your vibe!</p>
                    </div>
                </div>
                <div class="detail-row"><span>📍 Location</span><strong>College Music Corner</strong></div>
                <div class="detail-row"><span>🕒 Time</span><strong>Friday, 4:00 PM</strong></div>
                <div class="detail-row"><span>🎵 Status</span><strong id="jamStatus">Open to Join</strong></div>
                <div class="participants">
                    <div id="avatars" class="avatars"><span>🎧</span><span>🎸</span><span>🎤</span></div>
                    <p id="participantText">Be the first to join!</p>
                </div>
                <button id="joinJam" class="primary-btn join-btn">Join Jam Session →</button>
            </div>
        </section>

        <footer class="footer">
            <h3>♫ CampusBeats</h3>
            <p>Made with ❤️ for campus music lovers.</p>
            <p>Share what you love. Discover new sounds.</p>
        </footer>
    </main>
</div>

<div id="toast" class="toast"></div>

<script src="script.js"></script>
</body>
</html>
